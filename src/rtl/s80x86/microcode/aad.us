// AAD
.at 0xd5;
    width W8, ra_sel AH, jmp aad;
.auto_address;
// V30MZ: AL = AL + AH * 10 (8-bit, the immediate is ignored), AH = 0, Z/P from AL, S = 0
aad:
    a_sel RA, b_sel IMMEDIATE, immediate 0xa, alu_op IMUL, tmp_wr_en;
    width W8, ra_sel AL;
    width W8, a_sel RA, b_sel TEMP, alu_op ADD, update_flags ZF PF,
        rd_sel_source MICROCODE_RD_SEL, rd_sel AL;
    width W8, b_sel IMMEDIATE, immediate 0x0, alu_op SELB,
        rd_sel_source MICROCODE_RD_SEL, rd_sel AH;
    width W8, a_sel RA, b_sel IMMEDIATE, immediate 0x0, alu_op AND,
        update_flags SF, next_instruction;
